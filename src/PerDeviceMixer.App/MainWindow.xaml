<Window x:Class="PerDeviceMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PerDeviceMixer"
        Icon="Assets/PerDeviceMixer.ico"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1115"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>


    <Border BorderBrush="#30343C" BorderThickness="1" Background="#0F1115">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#14171C">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Source="Assets/PerDeviceMixer.png" />
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="PerDeviceMixer" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleButtonStyle}" Click="OnMinimizeClick">
                        <Path Width="10" Height="1" Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}" Click="OnMaximizeClick">
                        <Path Width="10" Height="10" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="OnCloseClick">
                        <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" Background="#14171C" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="10,18,10,0">
                        <Button Style="{StaticResource MixerNavButtonStyle}"
                                Command="{Binding ShowMixerCommand}"
                                ToolTip="音量合成器">
                            <Path Width="22"
                                  Height="22"
                                  Data="M 3,2 L 3,20 M 11,2 L 11,20 M 19,2 L 19,20 M 0,7 L 6,7 M 8,15 L 14,15 M 16,10 L 22,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource DevicesNavButtonStyle}"
                                Command="{Binding ShowDevicesCommand}"
                                ToolTip="声音设备">
                            <Path Width="22"
                                  Height="22"
                                  Data="M 2,8 L 6,8 L 11,3 L 11,19 L 6,14 L 2,14 Z M 15,7 C 18,9 18,13 15,15 M 17.5,4.5 C 23,8 23,14 17.5,17.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Button>
                        <Button Style="{StaticResource SettingsNavButtonStyle}"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip="设置">
                            <Path Width="22"
                                  Height="22"
                                  Data="M 11,2 A 9,9 0 1 1 10.9,2 M 11,7 A 4,4 0 1 1 10.9,7"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.7"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource MixerPageTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDevicesPage}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{DynamicResource DevicesPageTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{DynamicResource SettingsPageTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
