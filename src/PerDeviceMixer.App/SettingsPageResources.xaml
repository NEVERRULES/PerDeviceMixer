<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="SettingsPageTemplate">

<ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,24,30,28">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="设置" />
        <TextBlock Margin="0,5,0,22"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="13"
                    Text="控制音量记忆、启动和窗口行为" />

        <Border CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="自动记忆音量" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="记录你在系统或应用中做出的音量调整" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoLearn}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="切换设备时自动恢复" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="应用新设备已经保存的主音量和应用音量" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoRestore}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="新应用启动时恢复" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="稍后启动的应用也使用当前设备保存的音量" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding RestoreNewSessions}" />
                    </Grid>
                </Border>
                <Border Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="保存静音状态" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="恢复音量时同时恢复设备和应用的静音状态" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding SaveMuteState}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,22,0,10" FontSize="15" FontWeight="SemiBold" Text="系统与窗口" />
        <Border CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="开机自启动" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="登录 Windows 后在托盘中启动" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartWithWindows}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="关闭时最小化到托盘" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="关闭此选项后，点击关闭按钮将直接退出程序" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}" />
                    </Grid>
                </Border>
                <Border Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="单声道音频" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="在 Windows 官方无障碍音频页中安全切换" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenMonoAudioSettingsCommand}" Content="打开设置" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0"
                Padding="16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="保存延迟" />
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="连续拖动音量时合并写入，减少磁盘操作" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding SaveDebounceMilliseconds, StringFormat={}{0:0} ms}" />
                </Grid>
                <Slider Margin="0,14,0,0"
                        Minimum="100"
                        Maximum="5000"
                        TickFrequency="100"
                        IsSnapToTickEnabled="True"
                        IsMoveToPointEnabled="True"
                        Style="{StaticResource ModernSliderStyle}"
                        Value="{Binding SaveDebounceMilliseconds}" />
            </StackPanel>
        </Border>

        <Border Margin="0,20,0,0"
                Padding="16,14"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="本地配置自动保存" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Text="音量和设置会自动写入这台电脑，无需手动保存" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           Text="{Binding SettingsStatus}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,22,0,10" FontSize="15" FontWeight="SemiBold" Text="更新与支持" />
        <Border Padding="16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="自动检查更新" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="仅访问 GitHub Releases，不上传配置或音频数据" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Style="{StaticResource SwitchStyle}"
                              IsChecked="{Binding AutomaticUpdateChecks}" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="检查间隔" />
                    <ComboBox Grid.Column="1"
                              Padding="8,5"
                              ItemsSource="{Binding UpdateIntervals}"
                              SelectedItem="{Binding SelectedUpdateInterval}"
                              IsEnabled="{Binding IsUpdateIntervalEnabled}" />
                </Grid>

                <Border Margin="0,16,0,0"
                        Padding="12"
                        CornerRadius="8"
                        Background="#13161B"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionText}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Text="{Binding InstallTypeText}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           Text="{Binding AvailableVersionText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Content="立即检查" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="{Binding UpdateStatus}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Height="4"
                                     Margin="0,10,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UpdateDownloadProgress}" />
                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenAvailableReleaseCommand}"
                                    Content="查看 Release" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding DownloadAndInstallUpdateCommand}"
                                    IsEnabled="{Binding CanDownloadAndInstallUpdate}"
                                    Content="{Binding UpdateActionText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
                    <Button Margin="0,0,8,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenProjectCommand}"
                            Content="GitHub 项目主页" />
                    <Button Margin="0,0,8,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenReleasesCommand}"
                            Content="全部版本" />
                    <Button Margin="0,0,0,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenFeedbackCommand}"
                            Content="问题反馈" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
