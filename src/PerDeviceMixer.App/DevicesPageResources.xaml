<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="DevicesPageTemplate">

<ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,24,30,28">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="声音设备" />
        <TextBlock Margin="0,5,0,22"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="13"
                   Text="选择默认输出和输入，并控制设备音量" />

        <Border Margin="0,0,0,22"
                Padding="18,16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#2D8B68"
                BorderThickness="1"
                Visibility="{Binding HeadphoneBatteryVisibility}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding HeadphoneBatteryTitle}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Text="{Binding HeadphoneBatteryStateText}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="9,4"
                            CornerRadius="9"
                            Background="#183A30">
                        <TextBlock Foreground="#78D9B0"
                                   FontSize="11"
                                   Text="已连接" />
                    </Border>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="左耳" />
                        <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding LeftHeadphoneBatteryText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="右耳" />
                        <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding RightHeadphoneBatteryText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="充电盒" />
                        <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding CaseHeadphoneBatteryText}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="输出" />
            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding AddBluetoothDeviceCommand}"
                    Content="添加蓝牙设备" />
        </Grid>

        <Border CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <ItemsControl ItemsSource="{Binding OutputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,13"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="13" Height="13" Margin="0,0,12,0"
                                         Fill="{StaticResource AccentBrush}"
                                         Opacity="0.9" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding StateText}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Margin="10,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.SetDefaultOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanSetDefault}"
                                        Content="{Binding DefaultButtonText}" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.OpenDevicePropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="设备属性" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Margin="0,12,0,24"
                Padding="16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock FontWeight="SemiBold" Text="输出音量" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding CurrentDeviceName}" />
                </StackPanel>
                <ToggleButton Grid.Row="1" Margin="0,10,8,0" Style="{StaticResource MuteToggleStyle}" IsChecked="{Binding MasterMuted}" />
                <Slider Grid.Row="1" Grid.Column="1" Margin="0,13,8,0" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Style="{StaticResource ModernSliderStyle}" Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Width="34" Margin="0,13,0,0" VerticalAlignment="Center" Foreground="{StaticResource SliderAccentBrush}" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding MasterVolume, StringFormat={}{0:0}}" />
            </Grid>
        </Border>

        <TextBlock Margin="0,0,0,10" FontSize="15" FontWeight="SemiBold" Text="输入" />
        <Border CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <ItemsControl ItemsSource="{Binding InputDevices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,13"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding StateText}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="10,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.SetDefaultInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanSetDefault}"
                                        Content="{Binding DefaultButtonText}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.OpenDevicePropertiesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="设备属性" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Margin="0,12,0,16"
                Padding="16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock FontWeight="SemiBold" Text="输入音量" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding CurrentInputDeviceName}" />
                </StackPanel>
                <ToggleButton Grid.Row="1" Margin="0,10,8,0" Style="{StaticResource MicrophoneMuteToggleStyle}" IsChecked="{Binding InputMuted}" />
                <Slider Grid.Row="1" Grid.Column="1" Margin="0,13,8,0" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Style="{StaticResource ModernSliderStyle}" Value="{Binding InputVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Width="34" Margin="0,13,0,0" VerticalAlignment="Center" Foreground="{StaticResource SliderAccentBrush}" FontWeight="SemiBold" TextAlignment="Right" Text="{Binding InputVolume, StringFormat={}{0:0}}" />
            </Grid>
        </Border>

        <Border Padding="16"
                CornerRadius="10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="格式、增强和空间音效" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="这些功能由具体设备驱动提供，在设备属性页中统一管理" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenSoundDevicesCommand}" Content="打开设备高级设置" />
            </Grid>
        </Border>
    </StackPanel>
</ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
