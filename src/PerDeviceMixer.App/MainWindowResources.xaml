<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#191C22" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22262E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2F38" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA2AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="SliderAccentBrush" Color="#D98CE8" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#666A70" />

    <Style x:Key="TitleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#C7CDD6" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#252932" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#303640" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#AAB1BC" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="Indicator"
                                    Width="3"
                                    Height="24"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0"
                                    Background="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#22262E" />
                            <Setter Property="Foreground" Value="#F3F4F6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MixerNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMixerPage}" Value="True">
                <Setter Property="Background" Value="#253039" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                <Setter Property="Background" Value="#253039" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DevicesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDevicesPage}" Value="True">
                <Setter Property="Background" Value="#253039" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
        <Setter Property="AutoToolTipPrecision" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track" Height="30" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="2"
                                                        Background="{StaticResource SliderAccentBrush}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="2"
                                                        Background="{StaticResource SliderTrackBrush}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="26" Height="26" Cursor="Arrow" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="ThumbRing"
                                                         Width="18"
                                                         Height="18"
                                                         Fill="#343840" />
                                                <Ellipse x:Name="ThumbDot"
                                                         Width="10"
                                                         Height="10"
                                                         Fill="{StaticResource SliderAccentBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbRing" Property="Width" Value="22" />
                                                    <Setter TargetName="ThumbRing" Property="Height" Value="22" />
                                                    <Setter TargetName="ThumbDot" Property="Width" Value="12" />
                                                    <Setter TargetName="ThumbDot" Property="Height" Value="12" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbRing" Property="Width" Value="22" />
                                                    <Setter TargetName="ThumbRing" Property="Height" Value="22" />
                                                    <Setter TargetName="ThumbDot" Property="Width" Value="12" />
                                                    <Setter TargetName="ThumbDot" Property="Height" Value="12" />
                                                    <Setter TargetName="ThumbRing" Property="Fill" Value="#414650" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="#292D34" />
        <Setter Property="Foreground" Value="#F7F8FA" />
        <Setter Property="BorderBrush" Value="#3A4049" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuteToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E7EAF0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="静音" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Container"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}">
                        <Grid Width="22" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="SpeakerBody"
                                  Data="M 1,7 L 5,7 L 10,3 L 10,17 L 5,13 L 1,13 Z"
                                  Fill="{TemplateBinding Foreground}" />
                            <Path x:Name="SoundWaves"
                                  Data="M 13,7 C 15,9 15,11 13,13 M 16,4 C 20,8 20,12 16,16"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Path x:Name="MuteMark"
                                  Data="M 13.5,6 L 20,14 M 20,6 L 13.5,14"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#303640" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#3A414C" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#49302E" />
                            <Setter Property="Foreground" Value="#FFB4AB" />
                            <Setter Property="ToolTip" Value="取消静音" />
                            <Setter TargetName="SoundWaves" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MuteMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MicrophoneMuteToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E7EAF0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="将麦克风静音" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Container" CornerRadius="7" Background="{TemplateBinding Background}">
                        <Grid Width="20" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 10,2 C 7.8,2 6,3.8 6,6 L 6,11 C 6,13.2 7.8,15 10,15 C 12.2,15 14,13.2 14,11 L 14,6 C 14,3.8 12.2,2 10,2 Z M 3,10 C 3,14 6,17 10,17 C 14,17 17,14 17,10 M 10,17 L 10,21 M 7,21 L 13,21"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <Path x:Name="MuteSlash"
                                  Data="M 3,3 L 17,19"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#303640" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#3A414C" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="#49302E" />
                            <Setter Property="Foreground" Value="#FFB4AB" />
                            <Setter Property="ToolTip" Value="取消麦克风静音" />
                            <Setter TargetName="MuteSlash" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="28" Width="12" Focusable="False">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Border x:Name="ScrollThumb"
                                                    Width="4"
                                                    Margin="0,2"
                                                    HorizontalAlignment="Center"
                                                    CornerRadius="2"
                                                    Background="#59616D" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ScrollThumb" Property="Width" Value="8" />
                                                <Setter TargetName="ScrollThumb" Property="CornerRadius" Value="4" />
                                                <Setter TargetName="ScrollThumb" Property="Background" Value="#7A8491" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="ScrollThumb" Property="Width" Value="8" />
                                                <Setter TargetName="ScrollThumb" Property="CornerRadius" Value="4" />
                                                <Setter TargetName="ScrollThumb" Property="Background" Value="#9AA4B1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                    </Track>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SwitchStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="12" Background="#404651">
                        <Ellipse x:Name="Thumb"
                                 Width="18"
                                 Height="18"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 Fill="#E6E9EF" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#0F1115" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0B1A22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="#2A3039" />
        <Setter Property="Foreground" Value="#E8EBF0" />
    </Style>

    <Style x:Key="OutputDeviceComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Foreground" Value="#F3F4F6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Path x:Name="SelectedMark"
                                  Grid.Column="1"
                                  Width="12"
                                  Height="9"
                                  Margin="14,0,2,0"
                                  Data="M 1,4 L 4.5,7.5 L 11,1"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#2A3039" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#253039" />
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutputDeviceComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Foreground" Value="#F3F4F6" />
        <Setter Property="Background" Value="#242932" />
        <Setter Property="BorderBrush" Value="#3A414C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OutputDeviceComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboBorder"
                                            Padding="12,0,10,0"
                                            CornerRadius="7"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              TextElement.Foreground="#F3F4F6" />
                                            <Path Grid.Column="1"
                                                  Width="10"
                                                  Height="6"
                                                  Margin="14,0,0,0"
                                                  Data="M 1,1 L 5,5 L 9,1"
                                                  Stroke="#C7CDD6"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ComboBorder" Property="Background" Value="#303640" />
                                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#515965" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260"
                                    Margin="0,4,0,0"
                                    Padding="2"
                                    CornerRadius="8"
                                    Background="#20242B"
                                    BorderBrush="#414852"
                                    BorderThickness="1">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="MinHeight" Value="38" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="MixerPageTemplate">
<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="30,24,30,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="音量合成器" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       Text="切换设备时自动恢复它自己的音量" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Bottom"
                   Foreground="{StaticResource MutedBrush}"
                   Text="{Binding ApplicationCountText}" />
    </Grid>

    <Border Grid.Row="1"
            Margin="30,0,30,20"
            Padding="20,17"
            CornerRadius="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="当前输出" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="选择后立即切换系统默认输出" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Margin="18,0,0,0"
                          AutomationProperties.Name="选择当前输出设备"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                          Style="{StaticResource OutputDeviceComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <ToggleButton Grid.Row="1"
                          Margin="0,10,8,0"
                          Style="{StaticResource MuteToggleStyle}"
                          IsChecked="{Binding MasterMuted}" />
            <Slider Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,13,8,0"
                    Maximum="100"
                    Minimum="0"
                    IsMoveToPointEnabled="True"
                    Style="{StaticResource ModernSliderStyle}"
                    Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="2"
                       Width="34"
                       Margin="0,13,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SliderAccentBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextAlignment="Right"
                       Text="{Binding MasterVolume, StringFormat={}{0:0}}" />
        </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" Margin="30,0,22,24" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Applications}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,12"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38"
                                    Height="38"
                                    VerticalAlignment="Top"
                                    CornerRadius="8"
                                    Background="#22262E">
                                <Image Width="26"
                                       Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding IconSource}" />
                            </Border>
                            <Grid Grid.Column="1" Margin="14,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Margin="0,0,8,0"
                                                  Style="{StaticResource MuteToggleStyle}"
                                                  IsChecked="{Binding IsMuted}" />
                                    <Slider Grid.Column="1"
                                            Margin="0,0,8,0"
                                            Maximum="100"
                                            Minimum="0"
                                            IsMoveToPointEnabled="True"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2"
                                               Width="34"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SliderAccentBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               Text="{Binding Volume, StringFormat={}{0:0}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Grid>
    </DataTemplate>
</ResourceDictionary>
